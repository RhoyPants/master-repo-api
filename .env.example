DATABASE_URL="sqlserver://SERVER_HOST:1433;database=DB_NAME;user=DB_USER;password=DB_PASSWORD;encrypt=true;trustServerCertificate=true"
PORT=3000
NODE_ENV=development
JWT_SECRET="replace-with-a-strong-random-secret"

# SAP SQL Server direct connection
SAP_DB_SERVER=SAP_SERVER_HOST
SAP_DB_USER=sa
SAP_DB_PASSWORD=SAP_PASSWORD
SAP_DB_NAME=SAP_DB_NAME
